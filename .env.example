# Reference date for quote validity and policy expiry (10 Nov 2026 IST)
REFERENCE_DATE=2026-11-10

# Database URL: SQLite by default (zero-configuration setup)
# For PostgreSQL: postgresql://user:password@localhost:5432/autocover
DATABASE_URL=sqlite:///./autocover.db

# Mock Provider Server URL
MOCK_PROVIDER_URL=http://127.0.0.1:8001

# Simulation Flags
SIMULATE_SLOW_PROVIDERS=true
SIMULATE_FAILURES=false

# Port Configurations
BACKEND_PORT=8000
MOCK_PORT=8001
FRONTEND_PORT=5173

